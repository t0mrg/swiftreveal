      "kicker" : "SwiftReveal",
      "layout" : "title",
      "notes" : "Welcome to SwiftReveal. Every slide in this introduction is editable. Use the content inspector to replace this text, then explore the other layouts.",
      "split" : 0.5,
      "subtitle" : "An easier way to make professional presentations on your Mac",
      "title" : "Clear ideas,\nbeautifully arranged"
    },
    {
      "blocks" : [
        {
          "body" : "- Choose a slide layout from the inspector.\n- Edit the title, subtitle and content blocks.\n- Add or reorder blocks as your story changes.\n- Switch themes for the entire presentation.",
          "caption" : "",
          "heading" : "Start with the structure",
